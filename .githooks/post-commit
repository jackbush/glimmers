#!/bin/sh
# After each commit, refresh the homepage sketch's fallback copy from the live site (see
# scripts/homepage-content.mjs) and, if it changed, commit it on its own. The guard stops that
# commit from running this hook again.
[ -n "$HOMEPAGE_CONTENT_HOOK" ] && exit 0
node scripts/homepage-content.mjs || exit 0
SNAPSHOT=src/sketches/homepage/content.json
if ! git diff --quiet -- "$SNAPSHOT"; then
  HOMEPAGE_CONTENT_HOOK=1 git commit --quiet -m "homepage: refresh content snapshot from the live site" -- "$SNAPSHOT" \
    && echo "homepage: committed the refreshed content snapshot"
fi
