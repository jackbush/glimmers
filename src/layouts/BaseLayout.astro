---
import { url } from '../lib/sketches';

interface Props {
  title: string;
  /** Page background and theme-color. */
  background?: string;
  description?: string;
}

const { title, background = '#000', description } = Astro.props;
// Stamped with the commit hash by the Pages workflow; see src/kit/version.ts.
const build = import.meta.env.PUBLIC_BUILD || 'dev';
---

<!doctype html>
<html lang="en" style={`background:${background}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={background} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={title} />
    <meta name="build" content={build} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body style={`background:${background}`}>
    <slot />
    <script>
      import { autoReload } from '../kit/version';
      autoReload();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #f4f4f4;
    --ink-dim: rgba(255, 255, 255, 0.5);
    --line: rgba(255, 255, 255, 0.12);
    --accent: #fff;
    --mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
</style>
