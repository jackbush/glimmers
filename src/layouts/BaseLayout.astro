---
import { getSite, url } from '../lib/sketches';

interface Props {
  /** <title> and share title, verbatim: pages compose their own. */
  title: string;
  /** Name under the icon when the page is added to a home screen. */
  appTitle: string;
  /** Page background and theme-color. */
  background?: string;
  /** Link-preview image (1200×630) and its alt text. Defaults to the site's (public/share.jpg). */
  image?: string;
  imageAlt?: string;
}

const {
  title,
  appTitle,
  background = '#000',
  image = url('share.jpg'),
  imageAlt = 'Blackstar: a black orb with a burning halo on a yellow-orange gradient',
} = Astro.props;
const site = getSite();
// Stamped with the commit hash by the Pages workflow; see src/kit/version.ts.
const build = import.meta.env.PUBLIC_BUILD || 'dev';
// Share cards need absolute URLs; a relative og:image is dropped.
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" style={`background:${background}`}>
  <head>
    <meta charset="utf-8" />
    <!-- No pinch or double-tap zoom on phones (a deliberate trade against accessibility: zooming
         a full-screen sketch only breaks it). Desktop browsers ignore these, so their zoom still works. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={background} />
    <meta name="build" content={build} />

    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={url('icon-192.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="manifest" href={url('site.webmanifest')} />
    <meta name="application-name" content={appTitle} />
    <meta name="apple-mobile-web-app-title" content={appTitle} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body style={`background:${background}`}>
    <slot />
    <script>
      import { autoReload } from '../kit/version';
      autoReload();
      // iOS Safari ignores user-scalable=no, so block its pinch gestures on touch screens. Only
      // there: Safari on a Mac sends the same events for a trackpad pinch, which should still zoom.
      if (matchMedia('(pointer: coarse)').matches) {
        for (const type of ['gesturestart', 'gesturechange']) document.addEventListener(type, (e) => e.preventDefault());
        document.addEventListener('touchmove', (e) => { if (e.touches.length > 1) e.preventDefault(); }, { passive: false });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #f4f4f4;
    --ink-dim: rgba(255, 255, 255, 0.5);
    --line: rgba(255, 255, 255, 0.12);
    --accent: #fff;
    --mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  /* No double-tap zoom (pinch is handled above). */
  html { touch-action: manipulation; }
</style>
