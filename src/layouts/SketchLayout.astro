---
// The page around every sketch: a full-screen canvas, the back button (top left: to the index
// unless `back` is false, or to jackbush.github.io for visitors from there), the camera,
// play/pause and settings cog (top right; icons from Phosphor, regular weight, MIT,
// https://phosphoricons.com) and the settings pane, which
// slides in from the right (from the bottom on phones, as a sheet over the lower half;
// the sketch fits above it). The pane's rows are generated from the sketch's params.js by src/kit/panel.ts.
import BaseLayout from './BaseLayout.astro';
import { url } from '../lib/sketches';

interface Props {
  /** Tab and share title. */
  title: string;
  /** Home-screen name. */
  appTitle: string;
  /** Link-preview image (1200×630). */
  image?: string;
  imageAlt?: string;
  background: string;
  /** Show the back button to the index. Without it, the button only appears for visitors from jackbush.github.io. */
  back?: boolean;
}

const { title, appTitle, background, image, imageAlt, back = true } = Astro.props;
---

<BaseLayout title={title} appTitle={appTitle} background={background} image={image} imageAlt={imageAlt}>
  <canvas id="stage"></canvas>
  <div id="error" hidden></div>

  <a id="back" class="disc" href={url()} aria-label="All Glimmers" hidden={!back}>
    <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z" /></svg>
  </a>
  <script is:inline>
    // Opened from jackbush.github.io (?from=home): back goes home instead, even on a standalone sketch.
    if (new URLSearchParams(location.search).get('from') === 'home') {
      const back = document.getElementById('back');
      back.href = '/';
      back.setAttribute('aria-label', 'Back to Jack Bush');
      back.hidden = false;
    }
  </script>

  <button id="shot" class="disc" aria-label="Download a screenshot" title="Download a screenshot (2880×1864)">
    <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M208,56H180.28L166.65,35.56A8,8,0,0,0,160,32H96a8,8,0,0,0-6.65,3.56L75.71,56H48A24,24,0,0,0,24,80V192a24,24,0,0,0,24,24H208a24,24,0,0,0,24-24V80A24,24,0,0,0,208,56Zm8,136a8,8,0,0,1-8,8H48a8,8,0,0,1-8-8V80a8,8,0,0,1,8-8H80a8,8,0,0,0,6.66-3.56L100.28,48h55.43l13.63,20.44A8,8,0,0,0,176,72h32a8,8,0,0,1,8,8ZM128,88a44,44,0,1,0,44,44A44.05,44.05,0,0,0,128,88Zm0,72a28,28,0,1,1,28-28A28,28,0,0,1,128,160Z" /></svg>
  </button>

  <button id="play" class="disc" aria-label="Pause">
    <svg class="icon-pause" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M200,32H160a16,16,0,0,0-16,16V208a16,16,0,0,0,16,16h40a16,16,0,0,0,16-16V48A16,16,0,0,0,200,32Zm0,176H160V48h40ZM96,32H56A16,16,0,0,0,40,48V208a16,16,0,0,0,16,16H96a16,16,0,0,0,16-16V48A16,16,0,0,0,96,32Zm0,176H56V48H96Z" /></svg>
    <svg class="icon-play" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M232.4,114.49,88.32,26.35a16,16,0,0,0-16.2-.3A15.86,15.86,0,0,0,64,39.87V216.13A15.94,15.94,0,0,0,80,232a16.07,16.07,0,0,0,8.36-2.35L232.4,141.51a15.81,15.81,0,0,0,0-27ZM80,215.94V40l143.83,88Z" /></svg>
  </button>

  <button id="cog" class="disc" aria-label="Settings" aria-expanded="false" aria-controls="panel">
    <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M128,80a48,48,0,1,0,48,48A48.05,48.05,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32,0,0,1,128,160Zm109.94-52.79a8,8,0,0,0-3.89-5.4l-29.83-17-.12-33.62a8,8,0,0,0-2.83-6.08,111.91,111.91,0,0,0-36.72-20.67,8,8,0,0,0-6.46.59L128,41.85,97.88,25a8,8,0,0,0-6.47-.6A112.1,112.1,0,0,0,54.73,45.15a8,8,0,0,0-2.83,6.07l-.15,33.65-29.83,17a8,8,0,0,0-3.89,5.4,106.47,106.47,0,0,0,0,41.56,8,8,0,0,0,3.89,5.4l29.83,17,.12,33.62a8,8,0,0,0,2.83,6.08,111.91,111.91,0,0,0,36.72,20.67,8,8,0,0,0,6.46-.59L128,214.15,158.12,231a7.91,7.91,0,0,0,3.9,1,8.09,8.09,0,0,0,2.57-.42,112.1,112.1,0,0,0,36.68-20.73,8,8,0,0,0,2.83-6.07l.15-33.65,29.83-17a8,8,0,0,0,3.89-5.4A106.47,106.47,0,0,0,237.94,107.21Zm-15,34.91-28.57,16.25a8,8,0,0,0-3,3c-.58,1-1.19,2.06-1.81,3.06a7.94,7.94,0,0,0-1.22,4.21l-.15,32.25a95.89,95.89,0,0,1-25.37,14.3L134,199.13a8,8,0,0,0-3.91-1h-.19c-1.21,0-2.43,0-3.64,0a8.08,8.08,0,0,0-4.1,1l-28.84,16.1A96,96,0,0,1,67.88,201l-.11-32.2a8,8,0,0,0-1.22-4.22c-.62-1-1.23-2-1.8-3.06a8.09,8.09,0,0,0-3-3.06l-28.6-16.29a90.49,90.49,0,0,1,0-28.26L61.67,97.63a8,8,0,0,0,3-3c.58-1,1.19-2.06,1.81-3.06a7.94,7.94,0,0,0,1.22-4.21l.15-32.25a95.89,95.89,0,0,1,25.37-14.3L122,56.87a8,8,0,0,0,4.1,1c1.21,0,2.43,0,3.64,0a8.08,8.08,0,0,0,4.1-1l28.84-16.1A96,96,0,0,1,188.12,55l.11,32.2a8,8,0,0,0,1.22,4.22c.62,1,1.23,2,1.8,3.06a8.09,8.09,0,0,0,3,3.06l28.6,16.29A90.49,90.49,0,0,1,222.9,142.12Z" /></svg>
  </button>

  <aside id="panel" aria-hidden="true" aria-label="Settings">
    <div class="head">
      <span id="fps"></span>
    </div>
    <div id="controls"></div>
    <div class="state">
      <div class="changes"><input type="checkbox" id="show-changes" checked hidden title="Show the changes. Untick to compare with the defaults." aria-label="Show the changes"> <span id="status"></span> <button id="reset">[reset]</button></div>
      <button id="copy">Copy changes</button>
    </div>
  </aside>

  <slot />
</BaseLayout>

<style is:global>
  :root {
    --panel: #000;
    /* How much of the screen the open pane takes: a strip down the right, or on phones a sheet along the bottom. */
    --pane-right: min(410px, 100vw);
    --pane-bottom: 0px;
    --ease: cubic-bezier(.2, .7, .2, 1);
  }
  html, body { height: 100%; overflow: hidden; }
  #stage {
    /* lvh = full screen height including the area behind mobile browser bars, so the bars show
       the animation through them instead of a flat page colour. */
    position: fixed; top: 0; left: 0; width: 100%; height: 100%; height: 100lvh; display: block;
    transition: width .28s var(--ease), height .28s var(--ease);
  }
  /* With the pane open, the sketch fits the remaining area so its edges stay visible. */
  body[data-ui="on"][data-pane="open"] #stage {
    width: calc(100% - var(--pane-right)); height: calc(100dvh - var(--pane-bottom));
  }

  #error {
    position: fixed; inset: auto 16px 16px 16px; padding: 12px 14px; z-index: 5;
    font: 12px/1.5 var(--mono); white-space: pre-wrap; color: #ffd9c2; background: #2a0703; border: 1px solid #a3260b;
  }

  /* The round buttons: back on the left; camera, play/pause and settings on the right. */
  .disc {
    position: fixed; top: max(14px, env(safe-area-inset-top)); z-index: 3; width: 38px; height: 38px; padding: 8px;
    display: block; border: 0; border-radius: 50%; background: rgba(0, 0, 0, 0.3); color: var(--ink);
    cursor: pointer; opacity: 0.6; transition: opacity .2s, visibility .2s, transform .5s, background .2s;
  }
  .disc:focus-visible { opacity: 1; background: rgba(0, 0, 0, 0.6); }
  .disc svg { width: 100%; height: 100%; display: block; }
  /* Under the pane, so on narrow screens the pane covers it. */
  #back { left: max(14px, env(safe-area-inset-left)); z-index: 1; }
  #back[hidden] { display: none; }
  #cog { right: max(14px, env(safe-area-inset-right)); }
  #play { right: calc(max(14px, env(safe-area-inset-right)) + 46px); }
  #shot { right: calc(max(14px, env(safe-area-inset-right)) + 92px); }
  /* The camera only shows with the pane; it dims while the screenshot renders. */
  body:not([data-pane="open"]) #shot { opacity: 0; visibility: hidden; }
  #shot:disabled { opacity: 0.3; cursor: progress; }
  /* Play/pause shows while the settings pane is open, and stays after it closes while paused
     (so you can resume); once playing it fades out until the pane is next opened. */
  body:not([data-pane="open"]):not([data-paused="true"]) #play { opacity: 0; visibility: hidden; }
  #play .icon-play, body[data-paused="true"] #play .icon-pause { display: none; }
  body[data-paused="true"] #play .icon-play { display: block; }
  #cog[aria-expanded="true"] { opacity: 1; transform: rotate(60deg); background: rgba(0, 0, 0, 0.6); }
  /* Over the black pane the dark roundels vanish, so they turn faint white. (On phones the pane
     is a bottom sheet and the roundels stay over the sketch.) */
  @media (min-width: 700px) {
    body[data-pane="open"] #shot, body[data-pane="open"] #play, body[data-pane="open"] #cog { background: rgba(255, 255, 255, 0.1); }
    body[data-pane="open"] #shot:focus-visible, body[data-pane="open"] #play:focus-visible, body[data-pane="open"] #cog:focus-visible { background: rgba(255, 255, 255, 0.18); }
  }
  /* Hover only where there's a real pointer: touch browsers keep :hover after a tap, which
     left the cog dark and turned after closing the pane. */
  @media (hover: hover) {
    .disc:hover { opacity: 1; background: rgba(0, 0, 0, 0.6); }
    #cog:hover { opacity: 1; transform: rotate(60deg); background: rgba(0, 0, 0, 0.6); }
  }
  @media (hover: hover) and (min-width: 700px) {
    body[data-pane="open"] #shot:hover, body[data-pane="open"] #play:hover, body[data-pane="open"] #cog:hover { background: rgba(255, 255, 255, 0.18); }
  }

  #panel {
    position: fixed; top: 0; right: 0; bottom: 0; z-index: 2; width: var(--pane-right);
    display: flex; flex-direction: column; color: var(--ink); background: var(--panel);
    border-left: 1px solid var(--line); font: 11px/1.4 var(--mono);
    transform: translateX(102%);
    /* Closed, it's hidden once it has slid out, not just moved off screen: iOS Safari tints its
       toolbar from what's drawn behind it, and a dark sheet parked just past the bottom edge
       left the bar black after closing. Opening shows it at once, then it slides in. */
    visibility: hidden; transition: transform .28s var(--ease), visibility 0s linear .28s;
  }
  /* Space toggles data-ui (on = buttons shown); the cog toggles data-pane. */
  body[data-ui="on"][data-pane="open"] #panel {
    transform: none; visibility: visible; transition: transform .28s var(--ease), visibility 0s;
  }
  body[data-ui="off"] .disc, body[data-ui="off"] #panel { display: none; }
  /* Phones: a bottom sheet over the lower half of the visible screen. */
  @media (max-width: 699px) {
    :root { --pane-right: 0px; --pane-bottom: 50dvh; }
    #panel {
      top: auto; left: 0; width: 100%; height: var(--pane-bottom);
      border-left: 0; border-top: 1px solid var(--line); transform: translateY(102%);
    }
  }

  .head {
    display: flex; align-items: center; gap: 12px; min-height: 62px;
    padding: 14px 154px 10px 16px; padding-top: max(14px, env(safe-area-inset-top));
    border-bottom: 1px solid var(--line);
  }
  /* The sheet's head sits below the roundels, so it needn't clear them or the notch. */
  @media (max-width: 699px) {
    .head { min-height: 0; padding: 10px 16px; }
  }
  #fps { color: var(--ink-dim); flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  #controls { flex: 1; overflow-y: auto; padding: 4px 0 10px; overscroll-behavior: contain; }
  /* Rows are 3px apart top and bottom, so 3px more under the last row matches the gap between rows. */
  .group { border-bottom: 1px solid var(--line); }
  .group[open] { padding-bottom: 3px; }
  .group summary {
    cursor: pointer; padding: 10px 14px; list-style: none; user-select: none;
    letter-spacing: .14em; text-transform: uppercase; color: var(--ink); font-size: 10px;
  }
  .group summary::-webkit-details-marker { display: none; }
  .group summary::before { content: "▸ "; display: inline-block; width: 1.2em; }
  .group[open] summary::before { content: "▾ "; }

  .row { display: grid; grid-template-columns: 124px 1fr 84px; align-items: center; gap: 8px; padding: 3px 14px; }
  .row-select { grid-template-columns: 124px 1fr; }
  /* A checkbox keeps the three columns and sits in the last, lined up with the number boxes. */
  .row-bool input[type=checkbox] { grid-column: 3; }
  /* A dependent param whose parent's value makes it irrelevant (see `when` in kit/types.ts). */
  .row[hidden] { display: none; }
  .lbl { color: var(--ink-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: default; user-select: none; }
  .row.changed .lbl { color: var(--ink); }

  .track { position: relative; display: block; }
  .track .home { position: absolute; top: 4px; width: 1px; height: 10px; margin-left: -0.5px; background: var(--ink-dim); opacity: 0.6; pointer-events: none; }
  .track .home[hidden], .track .rerange[hidden] { display: none; }
  .rerange { position: absolute; right: 0; top: -9px; padding: 0 2px; border: 0; background: none; color: var(--ink-dim); font: 10px/1 var(--mono); cursor: pointer; }
  .rerange.at-min { right: auto; left: 0; }
  .rerange:hover { color: var(--ink); }
  #controls.bypassed { opacity: 0.45; pointer-events: none; }
  #show-changes { margin: 0 4px 0 0; vertical-align: -2px; accent-color: var(--accent); }
  input[type=range] { -webkit-appearance: none; appearance: none; width: 100%; height: 18px; background: transparent; margin: 0; }
  input[type=range]::-webkit-slider-runnable-track { height: 2px; background: rgba(255, 255, 255, 0.2); }
  input[type=range]::-moz-range-track { height: 2px; background: rgba(255, 255, 255, 0.2); }
  input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 10px; height: 10px; margin-top: -4px; border-radius: 50%; background: var(--ink-dim); }
  input[type=range]::-moz-range-thumb { width: 10px; height: 10px; border: 0; border-radius: 50%; background: var(--ink-dim); }
  .row.changed input[type=range]::-webkit-slider-thumb { background: var(--accent); }
  .row.changed input[type=range]::-moz-range-thumb { background: var(--accent); }

  .num {
    width: 100%; padding: 2px 4px; border: 1px solid var(--line); border-radius: 2px;
    background: #0d0d0d; color: var(--ink); font: 11px var(--mono);
  }
  .num:focus { outline: 1px solid var(--accent); }
  /* No spinner arrows on number boxes — the sliders do the stepping. */
  .num::-webkit-outer-spin-button, .num::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .num[type=number] { -moz-appearance: textfield; appearance: textfield; }
  .swatch { width: 100%; height: 18px; padding: 0; border: 1px solid var(--line); border-radius: 0; cursor: pointer; }
  .swatch:focus-visible { outline: 1px solid var(--accent); }

  /* The colour picker (src/kit/colour-picker.ts): a window over the pane on desktop; on phones it
     takes the sheet's place exactly, so the sketch above stays in view. */
  .picker {
    position: fixed; z-index: 5; display: flex; flex-direction: column;
    background: var(--panel); color: var(--ink); font: 11px/1.4 var(--mono);
    border: 1px solid var(--line); border-radius: 4px; overflow: hidden;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
  }
  .picker[hidden] { display: none; }
  .picker-bar { cursor: move; touch-action: none; display: flex; align-items: center; justify-content: space-between; padding: 6px 6px 6px 10px; border-bottom: 1px solid var(--line); }
  .picker-title { letter-spacing: .14em; text-transform: uppercase; font-size: 10px; user-select: none; }
  .picker-close { width: 22px; height: 22px; padding: 4px; border: 0; border-radius: 2px; background: none; color: var(--ink-dim); cursor: pointer; }
  .picker-close:hover, .picker-close:focus-visible { color: var(--ink); background: rgba(255, 255, 255, 0.1); outline: none; }
  .picker-close svg { width: 100%; height: 100%; display: block; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  /* A black hairline: the square's top row is white at every hue, so this always separates the
     two, even when the colour is near white (the pane's translucent line vanishes on light colours). */
  .picker-swatch { height: 48px; flex: none; border-bottom: 1px solid #000; }
  .picker-square { position: relative; aspect-ratio: 4 / 3; touch-action: none; cursor: crosshair; outline: none; }
  .picker-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .picker-hue { position: relative; height: 24px; flex: none; border-top: 1px solid var(--line); touch-action: none; cursor: ew-resize; outline: none; }
  .picker-dot {
    position: absolute; width: 14px; height: 14px; margin: -7px 0 0 -7px; border: 2px solid #fff; border-radius: 50%;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.5); pointer-events: none;
  }
  .picker-hue .picker-dot { top: 50%; }
  .picker[data-keys] .picker-square:focus .picker-dot, .picker[data-keys] .picker-hue:focus .picker-dot { box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.5), 0 0 0 3px var(--accent); }
  @media (max-width: 699px) {
    .picker {
      inset: auto 0 0 0; width: auto; height: var(--pane-bottom); border: 0; border-top: 1px solid var(--line);
      border-radius: 0; box-shadow: none; padding-bottom: env(safe-area-inset-bottom);
    }
    .picker-square { flex: 1; aspect-ratio: auto; }
    .picker-bar { cursor: default; }
  }
  input[type=checkbox] { justify-self: start; accent-color: var(--accent); margin: 0; }
  select {
    width: 100%; padding: 2px 4px; border: 1px solid var(--line); border-radius: 2px;
    background: #0d0d0d; color: var(--ink); font: 11px var(--mono); cursor: pointer;
  }
  select:focus { outline: 1px solid var(--accent); }

  .state { padding: 12px 14px max(14px, env(safe-area-inset-bottom)); border-top: 1px solid var(--line); display: grid; gap: 8px; }
  .changes { color: var(--ink-dim); }
  #reset { background: none; border: 0; padding: 0; color: var(--ink); font: inherit; cursor: pointer; }
  #reset:hover { text-decoration: underline; }
  #copy {
    width: 100%; padding: 9px; border: 0; border-radius: 2px; cursor: pointer;
    background: var(--ink); color: #000; font: 600 11px var(--mono); letter-spacing: .06em;
  }
  #copy:hover { background: #fff; }
</style>
