---
// The page around every sketch: a full-screen canvas, the back button (top left), the
// play/pause button and settings cog (top right) and the settings pane, which slides in from
// the right (from the bottom on phones, as a sheet over the lower two thirds; the sketch fits
// above it). The pane's rows are generated from the sketch's params.js by src/kit/panel.ts.
import BaseLayout from './BaseLayout.astro';
import { url } from '../lib/sketches';

interface Props {
  /** Tab and share title. */
  title: string;
  /** Home-screen name. */
  appTitle: string;
  /** Link-preview image (1200×630). */
  image?: string;
  imageAlt?: string;
  background: string;
}

const { title, appTitle, background, image, imageAlt } = Astro.props;
---

<BaseLayout title={title} appTitle={appTitle} background={background} image={image} imageAlt={imageAlt}>
  <canvas id="stage"></canvas>
  <div id="error" hidden></div>

  <a id="back" class="disc" href={url()} aria-label="All Glimmers">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 12H5" /><path d="M12 19l-7-7 7-7" />
    </svg>
  </a>

  <button id="play" class="disc" aria-label="Pause">
    <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <rect x="7" y="6" width="3.2" height="12" rx="0.8" /><rect x="13.8" y="6" width="3.2" height="12" rx="0.8" />
    </svg>
    <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M8.5 6.2v11.6a.8.8 0 0 0 1.2.7l9.3-5.8a.8.8 0 0 0 0-1.4L9.7 5.5a.8.8 0 0 0-1.2.7z" />
    </svg>
  </button>

  <button id="cog" class="disc" aria-label="Settings" aria-expanded="false" aria-controls="panel">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="3" />
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
    </svg>
  </button>

  <aside id="panel" aria-hidden="true" aria-label="Settings">
    <div class="head">
      <span id="fps"></span>
    </div>
    <div id="controls"></div>
    <div class="state">
      <div class="changes"><input type="checkbox" id="show-changes" checked hidden title="Show the changes. Untick to compare with the defaults." aria-label="Show the changes"> <span id="status"></span> <button id="reset">[reset]</button></div>
      <button id="copy">Copy changes</button>
    </div>
  </aside>

  <slot />
</BaseLayout>

<style is:global>
  :root {
    --panel: #000;
    /* How much of the screen the open pane takes: a strip down the right, or on phones a sheet along the bottom. */
    --pane-right: min(410px, 100vw);
    --pane-bottom: 0px;
    --ease: cubic-bezier(.2, .7, .2, 1);
  }
  html, body { height: 100%; overflow: hidden; }
  #stage {
    /* lvh = full screen height including the area behind mobile browser bars, so the bars show
       the animation through them instead of a flat page colour. */
    position: fixed; top: 0; left: 0; width: 100%; height: 100%; height: 100lvh; display: block;
    transition: width .28s var(--ease), height .28s var(--ease);
  }
  /* With the pane open, the sketch fits the remaining area so its edges stay visible. */
  body[data-ui="on"][data-pane="open"] #stage {
    width: calc(100% - var(--pane-right)); height: calc(100dvh - var(--pane-bottom));
  }

  #error {
    position: fixed; inset: auto 16px 16px 16px; padding: 12px 14px; z-index: 5;
    font: 12px/1.5 var(--mono); white-space: pre-wrap; color: #ffd9c2; background: #2a0703; border: 1px solid #a3260b;
  }

  /* The round buttons: back on the left; play/pause and settings on the right. */
  .disc {
    position: fixed; top: max(14px, env(safe-area-inset-top)); z-index: 3; width: 38px; height: 38px; padding: 8px;
    display: block; border: 0; border-radius: 50%; background: rgba(0, 0, 0, 0.3); color: var(--ink);
    cursor: pointer; opacity: 0.6; transition: opacity .2s, visibility .2s, transform .5s, background .2s;
  }
  .disc:focus-visible { opacity: 1; background: rgba(0, 0, 0, 0.6); }
  .disc svg { width: 100%; height: 100%; display: block; }
  /* Under the pane, so on narrow screens the pane covers it. */
  #back { left: max(14px, env(safe-area-inset-left)); z-index: 1; }
  #cog { right: max(14px, env(safe-area-inset-right)); }
  #play { right: calc(max(14px, env(safe-area-inset-right)) + 46px); }
  /* Play/pause shows while the settings pane is open, and stays after it closes while paused
     (so you can resume); once playing it fades out until the pane is next opened. */
  body:not([data-pane="open"]):not([data-paused="true"]) #play { opacity: 0; visibility: hidden; }
  #play .icon-play, body[data-paused="true"] #play .icon-pause { display: none; }
  body[data-paused="true"] #play .icon-play { display: block; }
  #cog[aria-expanded="true"] { opacity: 1; transform: rotate(60deg); background: rgba(0, 0, 0, 0.6); }
  /* Over the black pane the dark roundels vanish, so they turn faint white. (On phones the pane
     is a bottom sheet and the roundels stay over the sketch.) */
  @media (min-width: 700px) {
    body[data-pane="open"] #play, body[data-pane="open"] #cog { background: rgba(255, 255, 255, 0.1); }
    body[data-pane="open"] #play:focus-visible, body[data-pane="open"] #cog:focus-visible { background: rgba(255, 255, 255, 0.18); }
  }
  /* Hover only where there's a real pointer: touch browsers keep :hover after a tap, which
     left the cog dark and turned after closing the pane. */
  @media (hover: hover) {
    .disc:hover { opacity: 1; background: rgba(0, 0, 0, 0.6); }
    #cog:hover { opacity: 1; transform: rotate(60deg); background: rgba(0, 0, 0, 0.6); }
  }
  @media (hover: hover) and (min-width: 700px) {
    body[data-pane="open"] #play:hover, body[data-pane="open"] #cog:hover { background: rgba(255, 255, 255, 0.18); }
  }

  #panel {
    position: fixed; top: 0; right: 0; bottom: 0; z-index: 2; width: var(--pane-right);
    display: flex; flex-direction: column; color: var(--ink); background: var(--panel);
    border-left: 1px solid var(--line); font: 11px/1.4 var(--mono);
    transform: translateX(102%);
    /* Closed, it's hidden once it has slid out, not just moved off screen: iOS Safari tints its
       toolbar from what's drawn behind it, and a dark sheet parked just past the bottom edge
       left the bar black after closing. Opening shows it at once, then it slides in. */
    visibility: hidden; transition: transform .28s var(--ease), visibility 0s linear .28s;
  }
  /* Space toggles data-ui (on = buttons shown); the cog toggles data-pane. */
  body[data-ui="on"][data-pane="open"] #panel {
    transform: none; visibility: visible; transition: transform .28s var(--ease), visibility 0s;
  }
  body[data-ui="off"] .disc, body[data-ui="off"] #panel { display: none; }
  /* Phones: a bottom sheet over the lower two thirds of the visible screen. */
  @media (max-width: 699px) {
    :root { --pane-right: 0px; --pane-bottom: 66.667dvh; }
    #panel {
      top: auto; left: 0; width: 100%; height: var(--pane-bottom);
      border-left: 0; border-top: 1px solid var(--line); transform: translateY(102%);
    }
  }

  .head {
    display: flex; align-items: center; gap: 12px; min-height: 62px;
    padding: 14px 108px 10px 16px; padding-top: max(14px, env(safe-area-inset-top));
    border-bottom: 1px solid var(--line);
  }
  /* The sheet's head sits below the roundels, so it needn't clear them or the notch. */
  @media (max-width: 699px) {
    .head { min-height: 0; padding: 10px 16px; }
  }
  #fps { color: var(--ink-dim); flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  #controls { flex: 1; overflow-y: auto; padding: 4px 0 10px; overscroll-behavior: contain; }
  /* Rows are 3px apart top and bottom, so 3px more under the last row matches the gap between rows. */
  .group { border-bottom: 1px solid var(--line); }
  .group[open] { padding-bottom: 3px; }
  .group summary {
    cursor: pointer; padding: 10px 14px; list-style: none; user-select: none;
    letter-spacing: .14em; text-transform: uppercase; color: var(--ink); font-size: 10px;
  }
  .group summary::-webkit-details-marker { display: none; }
  .group summary::before { content: "▸ "; display: inline-block; width: 1.2em; }
  .group[open] summary::before { content: "▾ "; }

  .row { display: grid; grid-template-columns: 124px 1fr 84px; align-items: center; gap: 8px; padding: 3px 14px; }
  .row-select { grid-template-columns: 124px 1fr; }
  /* A checkbox keeps the three columns and sits in the last, lined up with the number boxes. */
  .row-bool input[type=checkbox] { grid-column: 3; }
  /* A dependent param whose parent's value makes it irrelevant (see `when` in kit/types.ts). */
  .row[hidden] { display: none; }
  .lbl { color: var(--ink-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: default; user-select: none; }
  .row.changed .lbl { color: var(--ink); }
  .row.changed .lbl::after { content: " •"; color: var(--accent); }

  .track { position: relative; display: block; }
  .track .home { position: absolute; top: 4px; width: 1px; height: 10px; margin-left: -0.5px; background: var(--ink-dim); opacity: 0.6; pointer-events: none; }
  .track .home[hidden], .track .rerange[hidden] { display: none; }
  .rerange { position: absolute; right: 0; top: -9px; padding: 0 2px; border: 0; background: none; color: var(--ink-dim); font: 10px/1 var(--mono); cursor: pointer; }
  .rerange.at-min { right: auto; left: 0; }
  .rerange:hover { color: var(--ink); }
  #controls.bypassed { opacity: 0.45; pointer-events: none; }
  #show-changes { margin: 0 4px 0 0; vertical-align: -2px; accent-color: var(--accent); }
  input[type=range] { -webkit-appearance: none; appearance: none; width: 100%; height: 18px; background: transparent; margin: 0; }
  input[type=range]::-webkit-slider-runnable-track { height: 2px; background: rgba(255, 255, 255, 0.2); }
  input[type=range]::-moz-range-track { height: 2px; background: rgba(255, 255, 255, 0.2); }
  input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 10px; height: 10px; margin-top: -4px; border-radius: 50%; background: var(--ink-dim); }
  input[type=range]::-moz-range-thumb { width: 10px; height: 10px; border: 0; border-radius: 50%; background: var(--ink-dim); }
  .row.changed input[type=range]::-webkit-slider-thumb { background: var(--accent); }
  .row.changed input[type=range]::-moz-range-thumb { background: var(--accent); }

  .num {
    width: 100%; padding: 2px 4px; border: 1px solid var(--line); border-radius: 2px;
    background: #0d0d0d; color: var(--ink); font: 11px var(--mono);
  }
  .num:focus { outline: 1px solid var(--accent); }
  /* No spinner arrows on number boxes — the sliders do the stepping. */
  .num::-webkit-outer-spin-button, .num::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .num[type=number] { -moz-appearance: textfield; appearance: textfield; }
  /* iOS Safari draws the swatch as a circle by default, which stretches to an oval here. */
  input[type=color] {
    -webkit-appearance: none; appearance: none; width: 100%; height: 18px; padding: 0;
    border: 1px solid var(--line); border-radius: 0; background: none; cursor: pointer;
  }
  input[type=color]::-webkit-color-swatch-wrapper { padding: 0; }
  input[type=color]::-webkit-color-swatch { border: 0; border-radius: 0; }
  input[type=checkbox] { justify-self: start; accent-color: var(--accent); margin: 0; }
  select {
    width: 100%; padding: 2px 4px; border: 1px solid var(--line); border-radius: 2px;
    background: #0d0d0d; color: var(--ink); font: 11px var(--mono); cursor: pointer;
  }
  select:focus { outline: 1px solid var(--accent); }

  .state { padding: 12px 14px max(14px, env(safe-area-inset-bottom)); border-top: 1px solid var(--line); display: grid; gap: 8px; }
  .changes { color: var(--ink-dim); }
  #reset { background: none; border: 0; padding: 0; color: var(--ink); font: inherit; cursor: pointer; }
  #reset:hover { text-decoration: underline; }
  #copy {
    width: 100%; padding: 9px; border: 0; border-radius: 2px; cursor: pointer;
    background: var(--ink); color: #000; font: 600 11px var(--mono); letter-spacing: .06em;
  }
  #copy:hover { background: #fff; }
</style>
