---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getListed, getSite, label, url } from '../lib/sketches';

const site = getSite();
const sketches = getListed();
---

<BaseLayout title={site.name} appTitle={site.name}>
  <main>
    <h1>{site.name}</h1>
    <ul>
      {sketches.map((s) => (
        <li>
          <a href={url(s.slug + '/')}>
            {s.cover.video ? (
              <video src={s.cover.video} poster={s.cover.poster} muted loop playsinline preload="none" aria-hidden="true" />
            ) : s.cover.poster ? (
              <img src={s.cover.poster} alt="" />
            ) : (
              <span class="blank" />
            )}
            <span class="name">{label(s)}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>

<script>
  // Only the covers on screen play; the rest sit on their poster frame. With reduced motion,
  // they all stay on the poster.
  const videos = document.querySelectorAll<HTMLVideoElement>('main video');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting && !still.matches) v.play().catch(() => {});
      else v.pause();
    }
  }, { rootMargin: '100px 0px' });
  videos.forEach((v) => io.observe(v));
</script>

<style>
  main {
    max-width: 840px; margin: 0 auto;
    padding: max(32px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right)) 64px max(16px, env(safe-area-inset-left));
    color: var(--ink); font: 11px/1.4 var(--mono);
  }
  h1 { margin: 16px 0 32px; font-size: 32px; line-height: 1; font-weight: 400; letter-spacing: .2em; text-transform: uppercase; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 40px; }
  a { display: block; color: inherit; text-decoration: none; }
  video, img, .blank { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; background: #111; }
  .name { display: block; margin-top: 10px; color: var(--ink-dim); letter-spacing: .14em; text-transform: uppercase; font-size: 10px; transition: color .2s; }
  a:hover .name, a:focus-visible .name { color: var(--ink); }
  a:focus-visible { outline: 1px solid var(--accent); outline-offset: 6px; }
</style>
