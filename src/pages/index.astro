---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getListed, getSite, url } from '../lib/sketches';

const site = getSite();
const lists = [
  { sketches: getListed(), more: false },
  { sketches: getListed('more'), more: true },
];
---

<BaseLayout title={site.name} appTitle={site.name}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Grenze+Gotisch&display=swap" />
  </Fragment>
  <main>
    <h1>{site.name}</h1>
    {lists.map(({ sketches, more }) => (
    <ul class:list={{ more }} hidden={more}>
      {sketches.map((s) => (
        <li>
          <a href={url(s.slug + '/')}>
            {s.cover.video ? (
              <span class="cover">
                {s.cover.poster && <img src={s.cover.poster} alt="" />}
                <video src={s.cover.video} muted loop playsinline preload="none" aria-hidden="true" />
              </span>
            ) : s.cover.poster ? (
              <img src={s.cover.poster} alt="" />
            ) : (
              <span class="blank" />
            )}
            <span class="name">{s.name}</span>
          </a>
        </li>
      ))}
    </ul>
    ))}
  </main>
</BaseLayout>

<script>
  // The second list (index.js `more`) shows only for ?all or #all.
  if (/(^|[?&])all\b/.test(location.search.slice(1)) || location.hash === '#all') {
    document.querySelectorAll<HTMLElement>('ul.more').forEach((ul) => (ul.hidden = false));
  }

  // Only the covers on screen play; the rest sit on their poster frame. With reduced motion,
  // they all stay on the poster. Each video is invisible over its still (its first frame) until
  // it's actually playing, then fades in, so loading never shows a blank or a jump.
  const videos = document.querySelectorAll<HTMLVideoElement>('main video');
  videos.forEach((v) => v.addEventListener('playing', () => v.classList.add('on'), { once: true }));
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting && !still.matches) v.play().catch(() => {});
      else v.pause();
    }
  }, { rootMargin: '100px 0px' });
  videos.forEach((v) => io.observe(v));
</script>

<style>
  main {
    --gutter-l: max(16px, env(safe-area-inset-left)); --gutter-r: max(16px, env(safe-area-inset-right));
    max-width: 840px; margin: 0 auto;
    padding: max(32px, env(safe-area-inset-top)) var(--gutter-r) 64px var(--gutter-l);
    color: var(--ink); font: 11px/1.4 var(--mono);
  }
  h1 { margin: 32px 0 24px; font: 400 72px/1 "Grenze Gotisch", serif; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 40px; }
  ul[hidden] { display: none; }
  ul.more { margin-top: 40px; padding-top: 40px; border-top: 1px solid var(--line); }
  a { display: block; color: inherit; text-decoration: none; }
  video, img, .blank, .cover { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; background: #111; }
  .cover { position: relative; overflow: hidden; }
  .cover video { position: absolute; inset: 0; height: 100%; background: none; opacity: 0; transition: opacity .4s ease; }
  .cover video.on { opacity: 1; }
  .name { display: block; margin-top: 10px; color: var(--ink-dim); letter-spacing: .14em; text-transform: uppercase; font-size: 10px; transition: color .2s; }
  a:hover .name, a:focus-visible .name { color: var(--ink); }
  a:focus-visible { outline: 1px solid var(--accent); outline-offset: 6px; }
  /* Phones: a smaller heading with less space above it, and covers run edge to edge. */
  @media (max-width: 699px) {
    h1 { margin-top: 26px; font-size: 58px; }
    a > .cover, a > img, a > .blank { width: calc(100% + var(--gutter-l) + var(--gutter-r)); margin-left: calc(-1 * var(--gutter-l)); }
    .cover img, .cover video { width: 100%; margin-left: 0; }
  }
</style>
